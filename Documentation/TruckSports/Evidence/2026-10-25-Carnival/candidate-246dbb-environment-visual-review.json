  "findings": {
    "kickball": {
      "clearedBasesAndRoutes": "The visible bases and dark plowed connecting routes remain clearly distinguishable from surrounding snow in both Snow Morning and Blizzard Night originals. The framing exposes only part of the diamond, so it does not prove every base is on screen simultaneously.",
      "snowAppearance": "Snow Morning contains plainly visible falling flake sprites and snow-covered ground with raised banks beside the cleared routes.",
      "readability": "Team scorebug and match/action strips are readable. Clear Morning is notably dark on contact sheets. Blizzard Night has strong bright glare across the upper field and far base, but dark route shape and near base remain distinguishable.",
      "subjectiveArtLimit": "Repeated rounded bank pieces and long strong shadows are conspicuous; their realism is a subjective limit, not proof of missing geometry."
    },
    "fishing": {
      "visibleSubjects": "Clear Day and Snow Morning originals show the river/bed texture, banks, rocks, trees, dock, truck, hoop/net and readable Player1/catch HUD. No blank output, magenta missing-material rendering or obvious missing core subject is seen in these samples.",
      "snowVisibility": "Snow Morning is dark and shows no obvious visible flakes or whitened banks/trees in this captured still. Snow/storm appearance is therefore NOT visually confirmed by this review, despite the separate probe reporting active emission. This is an appearance observation, not a confirmed runtime cause.",
      "lightingAndTexture": "Time-of-day changes are visible across contacts. Dense river surface/bed texture remains visible; temporal shimmer, wave motion and noir/night comfort cannot be accepted from still images.",
      "viewLimit": "The foreground tree covers much of the left side and near objects approach the bottom HUD; the flowing river channel and net remain visible. Captures are near match start and do not establish later fish/wolf/bear animation or full-match behavior."
    }
  },
