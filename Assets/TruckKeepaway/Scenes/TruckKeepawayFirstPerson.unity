  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "TRUCK KEEPAWAY \xB7 CUMULATIVE POSSESSION\nArena View or human-only split-screen
    First Person; AI-only uses broadcast. Random/explicit weather, Lively chaos and
    reproducible match seeds. Ramps, rotating sweepers, loose tires, mud and wandering
    SheepV5 vary the connected chase routes. Sheep blasts can knock you away or wreck
    your truck; a wrecked carrier drops the single ball, surviving carriers retain
    possession. Chains/effects are bounded and sheep replenish away from trucks.\n\nTwo
    to four competitors. First to hold the ball for a TOTAL of 30 / 60 / 90 seconds
    wins (default60). Your time persists after every steal; it need not be one uninterrupted
    hold.\n\nDrive using the source shown in setup. Reverse input brakes before reversing.
    Touch the neutral physical ball to collect it. A meaningful fresh truck-body
    hit INTO the carrier steals it. Coasting overlap and merely being rammed by the
    carrier do not steal. Simultaneous equal challenges leave ownership unchanged.\n\nOwnership
    transfers atomically before the former carrier explodes. The thief receives short
    visible steal/blast protection. Debris and blast-induced collisions never steal
    or recursively explode carriers. The same pair must separate before another steal.\n\nWrecked
    trucks respawn after about two seconds at a clear location. White protection
    rings prevent free pickup/steals until they expire; they are not an offensive
    shield. Other trucks remain live. Escaping the arena or genuinely becoming immobile/overturned
    triggers a fair return, dropping any carried ball in a reachable clear area.
    Possession pauses while recovering.\n\nAI uses the same NWH drive and body-contact
    rules: the carrier selects open routes while challengers intercept. Pause/disconnect
    freezes time and preserves every body, score and respawn clock. Rematch keeps
    configuration. Offline only; no permanent elimination."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
