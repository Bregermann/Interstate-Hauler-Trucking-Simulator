  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Teams are seats 1+3 against 2+4; unused human seats have actual AI partners/opponents.
    The trailer is the baton. Tow to the transfer zone, stop and press ACTION to
    unhitch. Your teammate backs under that same kingpin and holds ACTION to couple.
    Clear the old tractor before the next latch. Standard Relay has two physical
    legs. Obstacle Relay adds the offset barrier/chicane. Reverse-Hitch Relay requires
    an actual backward entry into the transfer zone before releasing. Extended Team
    Haul alternates both teammates through four real legs, with an editable five-minute
    default for three physical handoffs; the ordinary two-leg clock is restored in
    other modes. Each leg split includes its physical handoff; the next leg starts
    only when the next native hitch locks. Slow handoffs reduce the handoff award.
    A hard impact adds two seconds; carrying the load past a missed transfer adds
    five seconds once per station. Reverse-Hitch's required overshoot is exempt.
    Final cargo condition and penalty-adjusted finish time determine the team result.
    Both teammates share it. There is no trailer teleport or automatic transfer.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
