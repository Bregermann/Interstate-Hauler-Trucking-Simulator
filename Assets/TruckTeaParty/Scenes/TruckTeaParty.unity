--- !u!114 &100865369
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100865367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Host an elegant garden tea with a real articulated serving arm on your
    original NWH truck. Drive and steer use configured controls. ACTION grabs a nearby
    physical vessel touching the wrist sensor; a fresh ACTION press releases it.
    Hold ACTION and steer/accelerate to rotate the arm sideways/raise it while the
    truck handbrake holds. Pour: keyboard Q/PageUp/Y/O for drivers1\u20134, whole/half
    controller own right/left shoulder (whole RB). Bow: keyboard E/PageDown/B/P,
    whole West, own half stick-click. These extra keys are validated against every
    active keyboard driver's controls. Pour physically from the teapot spout into
    a hollow cup; the actual ballistic stream must cross its opening. Fill near85%;
    below75% is insufficient. Tea spills from missed streams, overflow or tipped
    cups. Dishes break on strong native impacts. Return/release the teapot, pick
    up a filled cup, drive gently to its marked guest and set it on the real table.
    An upright intact cup resting there for0.6seconds scores precision/intact/minimal-spill
    points once. Wrong guests cannot score. A nearby visible arm bow after serving
    adds15 courtesy points once. Animated guests react to actual service. AI uses
    the same vessels, arm, stream, table contacts and gestures. Three cups per guest
    are finite; a broken cup is lost, never replaced during play. Source pots contain
    finite tea. In-place serving tools do not teleport truck or cargo. Shared/chase/cab,
    profiles, pause/help/input recovery/results/rematch use the existing flow."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
    type: 2}
