--- !u!114 &275548485
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 275548483}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Drive and shove opponents out of the raised circular ring. First to five
    heat wins takes the match. Each credited opponent ring-out awards +1 activity
    point; the sole survivor earns +3 more. Points, ring-outs and heat wins are shown
    separately. Final ring-outs in one physics step give no survival bonus, but legitimate
    mutual ring-out points remain. Only meaningful recent physical pushes count;
    recovered, old or self-inflicted falls do not. The match still ends at five heat
    wins. Your authoritative chassis center must cross the visible outer edge: wheel
    overhang and being airborne inside do not eliminate you. Accelerate, steer, and
    brake before reversing. Press your assigned ACTION for one forward shove, then
    wait3.2seconds. A missed shove can carry you over the edge. Stopped trucks can
    be pushed; there is no stationary counter. At20seconds a warning announces the
    physical ring shrinking from23seconds toward its minimum. The visible surface
    and legal radius shrink together. An unresolved90second heat is an explicit draw
    and replay. Starts rotate each heat. Outfits and eyebrows are cosmetic. Recorded
    decisive replays offer angle, speed, rewind and skip. Pause/reconnect preserves
    the match; release and freshly confirm after replacement. No online services.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
