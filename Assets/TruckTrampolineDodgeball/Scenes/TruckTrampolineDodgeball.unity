  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "FIRST TEAM TO THREE \xB7 TRAMPOLINE DODGEBALL\nOne to four trucks per
    team; up to four humans and named AI. Drive, brake before reversing, and bounce
    from actual trampoline contact. Limited directional aftertouch nudges flight;
    it cannot sustain flight.\n\nPress your assigned ACTION to strike in a short
    visible forward window. It works on the ground or in the air, returns a nearby
    incoming ball, and has a cooldown. Face your intended target. A struck ball takes
    your team's color. A live opposing ball eliminates a vulnerable truck. Your own
    team's ball is safe; the striker also receives a short launch grace. Ground contact
    returns a ball to cream NEUTRAL. One contact cannot eliminate a crowd. Landing
    on the trampoline never eliminates a truck.\n\nLast surviving team wins. All
    contacts within a physics step are ordered before resolving the teams; a simultaneous
    wipe draws and replays the round. At 75 seconds SUDDEN DEATH increases legal
    strike speed for everyone; at 105 seconds an unresolved round explicitly draws.
    No hidden homing or immunity. Shared arena view is the default; human chase split-screen
    is selectable. Replays show the actual recorded flight and ball colors, with
    angle, slow/fast, rewind and skip. Pause/reconnect preserves the round. Offline
    only."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
    type: 2}
