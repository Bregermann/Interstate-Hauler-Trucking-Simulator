  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Build one giant snowman together. Physically push the three snow seeds
    down the marked loose-snow lanes. Snow grows only from real grounded rolling;
    spinning in place, sliding without rotation and flying collect none. Snow patches
    have finite supplies. Suggested base/middle/head sizes are 2.4 / 1.7 / 1.2 m
    radius; different drift depths help proportions. Deliver each ball to the marked
    collection forecourt. ACTION requests the village hoist when the next ball is
    large enough and physically delivered. It lifts the dynamic ball, then releases
    it into actual ground or sphere contact. Only aligned, slow contact packs the
    snow at its measured pose; nothing snaps into place.

    After all three balls
    are packed, drive to the decoration cabinet. At low speed, steering selects item,
    throttle/brake selects style; ACTION picks it up. Drive near the statue and ACTION
    animates its placement. Choose carrot, coal face, scarf, hat, stick arms and
    a novelty toy. You can change a style before finishing. ACTION empty-handed near
    the finished stable snowman, or FINISH in the HUD, completes the build. Team
    grade rewards measured height, proportions, stability, decoration and completion
    time. All helpers use actual physics/actions. Save/restore uses the shared workshop
    adapter at stopped/paused stable boundaries; ongoing hoist or decoration motion
    must finish first. Saved completed designs reopen as galleries without another
    score.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
