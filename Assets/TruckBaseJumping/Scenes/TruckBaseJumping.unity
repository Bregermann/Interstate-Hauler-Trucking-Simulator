  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "TRUCK BASE JUMPING \xB7 FOUR TRUCKS, ONE SHARED WEATHER FIELD\nThree rounds.
    One to four humans plus AI, or four-AI spectator mode. All four release at the
    same altitude/time with equal initial target range. Starting positions rotate.\n\nMovement
    is compass aligned: left/right across the field, forward/back north/south. Freefall
    permits bounded air steering and pitch. ACTION deploys once: your shown keyboard
    key, whole-pad South, shared-left LT or shared-right RT. Release it after opening,
    then hold it again to FLARE / BRAKE. The canopy opens progressively; velocity
    never snaps to zero. Too-late or missed deployment risks a crash.\n\nThe same
    wind field drives every competitor. Canopies feel much stronger drift. Early
    opening gives more aiming time and more wind exposure; late opening is faster
    and riskier. Flare slows descent and horizontal motion but cannot hover.\n\nFIRST
    ground contact locks body-center landing error/time and incoming descent/attitude.
    Safe requires an open canopy, descent <=8m/s, horizontal speed <=12m/s and upright
    attitude. Driving/sliding afterward cannot improve it. No competitor collisions
    or blocking landed trucks. Escaping the field or 110 active seconds without landing
    is invalid.\n\nROUND RANKING: safe INSIDE the marked target beats safe outside.
    Within each category, compare ONE-METRE accuracy bands, then faster landing time,
    then exact error. Distances are stored to 1 mm and shown in feet/inches; times
    to 1 ms. Valid places award 4/3/2/1; crashes earn0. Exact round ties share place/points.
    Overall: total points, then lower total valid error, then lower total valid time;
    another four-truck round if still tied.\n\nPause/disconnect preserves flight,
    canopy, weather time and scores. Release controls and confirm freshly after reconnect
    or replacement. Rematch retains names, colors, sources and AI levels. Offline
    only."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
