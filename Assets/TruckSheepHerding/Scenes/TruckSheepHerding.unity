  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Four farm trucks, a wandering animated flock, and four open timber pens.
    Guide ordinary sheep into YOUR colored pen using your truck's position, controlled
    low-speed movement and the dedicated HORN. Sheep flee approaching trucks, respond
    to honking and stay with nearby flock mates. Gentle pressure is predictable;
    fast reckless approaches scatter them. Every sheep must physically enter the
    pen completely, and scores exactly once. Hitting ordinary sheep awards nothing.
    Rare warning-marked explosive sheep detonate after genuine truck contact and
    a short warning, scatter nearby flock mates and knock lightweight field fences
    loose; they never award herd points. Most sheep after three minutes wins; equal
    counts use the earliest valid final capture time, with exact ties shared. Two/five-minute
    options. AI physically drives behind sheep and guides them through the same pen
    contacts, without teleporting animals or automatic points. Shared/chase/full
    cab, Your Crew, horn, weather, optional AI cameras, recorded review and rematches
    use the collection systems.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
