  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "ARCADE WALLBALL \u2022 FIRST TO 11, WIN BY TWO \u2022 RALLY SCORING.\n\nBoth
    trucks share the court and pass through each other. Drive and jump at any time
    in a rally. Only the named eligible truck can touch the ball. Eligibility changes
    never freeze movement; separate from an overlapping ball to arm a fresh physical
    contact.\n\nPhysically hit the ball into the highlighted front wall before it
    touches the floor. A legal wall contact makes the opponent eligible. Volley it,
    or return after one floor bounce; SECOND BOUNCE loses the rally. A floor contact
    before reaching the wall is MISSED WALL. Invalid wall contact or side/rear escape
    is OUT against the responsible hitter, even if the receiver declines an out ball.
    Every rally awards one point; the winner serves next.\n\nSERVE: drive from the
    marked service box into the reachable ball. You have 25 active serving seconds.
    Countdown/pause do not consume this time. The opening server alternates on rematches.
    Genuine simulation failures replay neutrally with unchanged score.\n\nKeyboard
    defaults: W/A/S/D + SPACE jump; arrows + RIGHT SHIFT jump. Whole pad: left stick
    steer, RT/LT drive/brake, SOUTH/A/Cross jump. Shared pad: LEFT STICK + LT jump;
    RIGHT STICK + RT jump. North joins. Esc/Start pauses. Actual assigned controls
    appear in setup/HUD. Reconnect/reassign requires release and fresh confirmation;
    confirmation never becomes a jump.\n\nThese are simplified arcade rules, not
    an official tournament ruleset."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
