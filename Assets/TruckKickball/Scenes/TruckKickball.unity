  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Six-a-side by default; choose 3v3 through 6v6 and 1/3/5/7 innings. Four
    local humans maximum. Blue kicks first. Pitcher: steer to aim, throttle/brake
    select speed, ACTION rolls the real ball. Kicker: drive your bumper into the
    pitch; approach speed and contact offset determine power, loft and spin. Three
    strikes retire a kicker; four balls award a walk. Fouls count only up to two
    strikes.\n\nAfter a fair kick, physically drive HOME \u2192 FIRST \u2192 SECOND
    \u2192 THIRD \u2192 HOME. Runners wait at their bases until the kick. Touch each
    large pad in order. Defenders secure the ball by actual front-cup contact and
    carry it visibly. Face a base or teammate and press ACTION to throw. Touch a
    forced base while holding the ball for a force out; collide with an unsafe runner
    for a tag. Fly catches retire the kicker; runners must return and tag their original
    base before advancing. A third force out cancels runs from that play. Three outs
    swap teams. Tied regulation games continue into extras.\n\nA fair airborne ball
    clearing the outfield fence is a home run; runners still physically round the
    bases. A grounded ball leaving the fenced field awards a ground-rule double,
    also driven physically. Walks and home runs use the same NWH controls to assist
    forced advancement. Three-a-side bases-loaded play remains live until a runner
    frees a kicking slot: no ghost runners.\n\nChoose Broadcast, Chase or Taxi Cab.
    Human-only split screens are default; Show AI Cameras is optional. Cab free look
    and animated steering respect device ownership. Highlights record actual motion,
    with angle, slow/fast, rewind and skip; scoring stays locked. Pause/reconnect
    preserves the match. Genuine 60-second unresolved loose-ball or out-of-world
    recovery never awards invented runs. Offline only."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
