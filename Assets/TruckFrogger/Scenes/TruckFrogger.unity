  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Five independently selectable one-life crossing challenges: busy UTS traffic,
    freight railway, moving river barges, industrial machinery and the ultimate combination.
    Championship plays all five. One to eight alternating drivers, up to four local
    humans, named AI and difficulty. Everyone faces the same seeded hazard positions
    and weather for that challenge. There are no checkpoint respawns during an attempt.
    Drive, brake and wait for a genuine gap; meaningful solid crashes, drowning or
    leaving the course end your attempt. A whole-truck finish after every crossing
    records actual time. Fastest successful driver earns exactly one point, failures
    earn none. Ties use successful times then actual additional tiebreak runs; three
    unresolved retries produce an announced shared draw. AI physically waits, drives
    and crosses under the same rules. Hold ACTION for two seconds to retire a stuck
    attempt. Horn, chase, cab, elevated view, free look, pause and reconnect use
    established controls. All spectators watch the active alternating driver; optional
    AI cameras never create redundant views. Selected weather remains unchanged between
    turns. Recorded highlights, results and rematch preserve authoritative times.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
