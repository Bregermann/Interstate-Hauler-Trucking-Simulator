  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Eight trucks. One giant ticking bomb. Any real truck-body bump passes
    it: no speed threshold, no proximity transfer. Resting contact cannot repeatedly
    swap it; the same pair must separate and a visible 0.7-second transfer cooldown
    must expire. The carrier gets a modest 15% engine-power boost. An unpredictable
    12\u201320-second fuse eliminates the carrier with a physical truck-shattering
    blast. Blast damage never passes the bomb. A new cycle selects one survivor;
    last truck standing wins. +10 for your first successful pass each cycle, +20
    for surviving a cycle and +100 for sole survival. Pass counts remain visible,
    but repeated passes in one cycle cannot farm points. Human and named AI trucks
    obey the same contacts and timer. AI carriers chase; others evade. Use normal
    throttle/brake/steering. ACTION recovers an overturned or genuinely stuck truck
    at its current safe location; it never pauses the bomb. Shared, chase and full-cab
    cameras, free look, optional AI views and the universal horn are available. Weather,
    crew names/colors and inputs use the shared collection settings. Match-end replays
    are recorded transforms and never change results."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
