  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "TRUCK CURLING \xB7 THE TRUCK IS THE STONE\nTwo teams of one to four. Eight
    alternating deliveries per team per end; roster members rotate. Choose2 /4 /8
    ends (default4). A tied match continues into extra ends. Only one truck receives
    control at a time; hot seat may share a source, or use separately assigned inputs.\n\nFIRST
    PERSON: drive and steer in the preparation area. Back input brakes before reversing.
    The 234m sheet has a 30m approach. Entry speed maps linearly to release speed
    (20m/s entry =14.8m/s release); 25% is a short slide and full power reaches the
    far house. Crossing the release line commits your direction and disables the
    engine/wheels. Steer left/right for a small bounded curl during the first four
    seconds, then slide freely. There are no sweepers, late propulsion or hidden
    button correction. Watch speed, the release stripe and tactical house inset.\n\nEvery
    truck has the same visible circular scoring/collision footprint. Touching the
    house qualifies. Only the team nearer the button scores: one point per own in-house
    truck closer than the opponent's closest. An exact closest-distance tie is blank.
    The scoring team gives up hammer; a blank retains it.\n\nSide walls are legal
    arcade bank surfaces: rebound into the house or other stones. Passing completely
    beyond the back line removes a stone. Finish short of fully crossing the far
    hog line: removed, unless the delivery contacted another in-play stone. The first
    FIVE deliveries protect opposing free guards outside the house and before the
    tee: removing one restores ALL previous positions and removes the offending delivery.\n\nAll
    affected stones must settle. A genuine 70-second simulation failure removes the
    delivery and restores the prior layout. Rematch preserves setup. This is arcade-scale
    curling with cab controls, not full tournament fidelity: no human sweepers, no-tick,
    official clocks, burned-stone adjudication or equipment rules. Pause/disconnect
    preserves live slides; inputs require release after modal transitions."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
