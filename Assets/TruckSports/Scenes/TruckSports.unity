  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "BILLIARDS\nBumper strikes, stronger opening break, single racks or series.
    Human / AI slots, Practice and hot seat. Both groups potted legally? The shooter
    chooses.\n\nHOCKEY\n3v3 simultaneous driving. 0\u20136 humans with coordinated
    AI. Full puck crossing scores for the attacking TEAM; own goals count. Tied regulation
    enters sudden death. Rematches swap ends.\n\nHockey: opposite throttle brakes
    then reverses. Six editable keyboard clusters, whole controllers or left/right
    shared sticks. Start / Escape pauses; Pause recovers an individual slot.\n\nMenus:
    mouse, arrows / D-pad / stick; Enter / South submits. Input Check highlights
    all six sources. Test keyboard rollover on your hardware.\n\nTRUCK BOWLING\nThe
    truck is the ball. First-person cab, ten-pin scoring. 1\u20134 independent simultaneous
    lanes or 1\u20138 frame-based hot seat. No online play or powerups.\n\nAIR HOCKEY\nTruck
    mallets stay in their own halves. First to 7. Whole puck crossings count; own
    goals credit the opponent. The conceding player serves. Rematches alternate opening
    serve.\n\nWALLBALL\nBoth trucks drive and jump; only the named receiver hits.
    Hit the front wall before the floor, then volley or return after one bounce.
    First to 11, win by two.\n\nCORNHOLE\nThe truck IS the bag: ramp, trampoline,
    then land on or through the board. 1\u20134 simultaneous courses, driver-seat
    view and multi-angle replays. Full rules in Cornhole help."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
