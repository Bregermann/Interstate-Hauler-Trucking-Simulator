  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "SWING SIX TONS. DROP THE TRAILER. PLUG THE HOLE.\n\nYour assigned movement
    inputs pump the established bungee swing. ACTION releases the real hitch, once.
    The trailer keeps its actual velocity and spin. The truck stays on its bungee.
    Release timing determines the landing; there is no homing or midair control.\n\n100
    points per distinct pedestrian physically struck at meaningful speed. Ragdolls
    cannot score twice. A supported, quiet trailer earns 500\u20132,000 points for
    partial coverage, 5,000 for a seal, and 2,000 extra for a centered upright seal.
    Coverage is measured through the actual trailer colliders after 1.8 seconds of
    stable observation. Hovering, brushing the rim or ongoing motion cannot bank
    a plug.\n\nThe finite crowd emerges faster as you wait. Release within 35 seconds;
    the watchdog releases a stalled rig with its existing momentum. A delivery still
    moving after 40 seconds retains actual pedestrian hits but earns no unproven
    resting bonus. Spawning stops on a confirmed seal.\n\nOne to four participants
    take alternating turns. Three or five drops EACH; highest cumulative score wins
    and ties share victory. Pause/reconnect preserves the hitch, flight, crowd and
    scores. Recorded replays use actual transforms, never resimulate the result.
    AI uses the same pump and release controls. Offline only."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
