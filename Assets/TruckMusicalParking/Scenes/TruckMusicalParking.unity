  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "WHEN THE MUSIC STOPS, FIND A SPACE\nEight trucks circle the painted outer
    loop. Up to four humans, independent sources, AI fills. Music lasts an unpredictable5\u201312s.
    Red bays are CLOSED. Keep circulating outside them; the horn and green OPEN signs
    signal the scramble, even with audio muted. AI learns the stop only when you
    do.\n\nMOVEMENT DRIVES / BRAKES / REVERSES\nPark your WHOLE scoring footprint
    inside an open bay, under0.9m/s and upright for one continuous second. The progress
    strip shows capture. Rivals can push you before it locks. A secured truck is
    protected, earns one space only and cannot be displaced for that round. Exact
    simultaneous claims use a rotating seeded priority; callback order has no role.\n\nNO
    CAMPING\nYou need real forward movement on the outer loop, including recent movement
    outside bays when the horn sounds. Otherwise DRIVE THE LOOP8m before capturing.
    The HUD warns early; no punitive teleport.\n\nONE ELIMINATION PER ROUND\nWith
    one fewer space than trucks, the remaining unparked truck is eliminated. After28s,
    if several remain, eliminate the lowest CURRENT valid capture progress; ties
    lose by greater distance to a free bay; exact ties use rotating seeded priority.
    Previously displaced progress is not banked. All other contenders advance, even
    if timeout leaves several unparked. Seven rounds, one winner. Eliminated humans
    keep the shared spectator view. Each round resets onto a validated outer grid
    and rotates the bay arrangement. Rematch retains names/colors/sources/difficulty.
    Pause/disconnect preserves music position, motion and claims. Offline only."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
    type: 2}
