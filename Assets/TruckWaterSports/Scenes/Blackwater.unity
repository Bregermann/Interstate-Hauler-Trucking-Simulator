MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1726280177}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Drive and steer your physical barge; reverse thrust brakes. Hard normal
    collisions with sufficient impulse damage the hull; gentle docking and glancing
    scrapes are protected. Entity strikes remain a separate danger. ACTION rights
    a capsize. Crossing follows lit buoys to the far shore. Supply Run: touch a real
    unclaimed crate, then return it slowly inside the dock. Survival ranks actual
    time afloat; slowing quietly can shake pursuit, but lingering silence eventually
    draws it back. In crossing/delivery modes the green navigation lights repel direct
    strikes and slowly restore hull; wakes still move you. Cooperative Escape needs
    shared supplies, every boat upright and moving slowly back inside the dock, and
    no stranded teammates. Any boat can carry supplies. Hold ACTION while gently
    touching a stranded teammate for two seconds to repair them. AI can collect,
    brake, seek shelter and physically rescue. Cooperative success awards no individual
    winner point.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4294967295
  m_fontColor: {r: 1, g: 1, b: 1, a: 1}
  m_enableVertexGradient: 0
  m_colorMode: 3
  m_fontColorGradient:
