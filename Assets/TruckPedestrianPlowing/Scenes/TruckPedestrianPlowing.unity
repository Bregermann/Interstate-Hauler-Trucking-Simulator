  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PARADE PANDEMONIUM\nDrive into the marked cartoon targets. Blue +10 badges:
    10 points. Gold shirts / stars: 100 points. Red STOP / cross badges: \u2212100
    points. Roles never depend on character appearance.\n\nOne score per pedestrian,
    credited to the first meaningful physical truck impact. Fallen bodies never score
    again. Scores can be negative. Three minutes, or clear every positive target.
    Surviving red targets do not prevent completion. Ties share placing.\n\nChoose
    shared arena, split chase or driver cab. Up to four humans and eight total competitors.
    Movement alone plays the sport. Reverse brakes before reversing. Cab: whole pad
    right stick; primary keyboard hold right mouse to look, middle click recenters.
    Shared sticks retain independent driving.\n\nEsc / Start pauses. Reconnect or
    explicitly replace a missing device, release inputs, then freshly resume. Rematch
    retains your names, colors and sources. Results offer optional multi-angle slow/fast
    impact highlights."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
