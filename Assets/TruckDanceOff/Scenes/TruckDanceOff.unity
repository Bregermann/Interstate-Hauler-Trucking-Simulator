  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "FOUR LANES. SIX TONS OF RHYTHM.\nMatch LEFT / DOWN / UP / RIGHT on the
    beat. Keyboard uses your assigned movement keys; a whole controller uses D-pad
    or West / South / North / East face buttons. Shared controllers use each participant's
    owned stick. Diagonal chords never require opposite stick directions. Hold long
    notes through their tail.\n\nPerfect \xB145ms \xB7 Great \xB190ms \xB7 Good \xB1160ms.
    Wrong presses break your combo and cost 20 points; every scored note is judged
    once from input timestamps, never from an animation or frame rate. During FREESTYLE,
    vary directions and diagonals in time: repeated mashing earns nothing.\n\nSeven
    original complete genre tracks, four charts each. SINGLE SONG or THREE-SONG SHOW;
    highest total wins, ties share the stage. Use CALIBRATE in setup: listen to the
    pulse and tap your assigned lane to measure your display/audio/input delay, or
    adjust the saved timing offset.\n\nSuccessful input drives cute truck dances,
    then donuts, wheelies and breakdance stunts as combos build. Misses show a shy
    recovery. Pause and reconnect preserve song position; release all lanes before
    the resume count-in. Each truck owns its lanes, score and platform. One shared
    stage camera and one audio listener. Offline only."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
