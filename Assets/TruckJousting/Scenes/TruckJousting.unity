  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Two full semi-trucks charge along opposite tournament lanes. Your giant
    side-mounted lance has a real physical tip: strike the opposing truck''s shield.
    Armor earns1point; the central gold mark earns2. A truck genuinely overturned
    shortly after a credited hit upgrades that pass to3points. Only one lance hit
    scores per player per pass. Misses and wall hits earn nothing. Press ACTION to
    toggle lance aiming: directions then raise/lower and yaw the lance while your
    last accelerator command is held. Press ACTION again to drive. Aim is limited;
    steer and accelerate normally in driving mode. Lance tips and splinters react
    physically and reset each pass. Highest score after three or five passes wins;
    equal totals share placing. No invisible automatic hits, random knockdowns or
    AI-only points. Shared/chase/cab views, free look, horn, weather, Your Crew,
    optional AI cameras and a skippable recorded replay use the collection systems.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
