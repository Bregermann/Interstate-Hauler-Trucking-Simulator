  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Race to the checkered line. GREEN means drive. The giant master''s laugh
    is your ONE-SECOND warning to brake before RED: there is no yellow light. Deliberate
    forward/backward movement, creeping or continued rolling on red causes one huge
    truck-shattering explosion. Small suspension jitter and motion caused entirely
    by another truck''s measured impact do not count. A collision gives no blanket
    immunity to throttle-driven travel. Your whole truck must clear the finish inside
    the track. First legal finisher wins; remaining racers have ten seconds to place.
    If nobody legally finishes, the results say so. Twelve competitors, up to four
    local humans, real AI braking and difficulty, shared/chase/cab views and optional
    AI cameras. Use the existing throttle/brake/steer bindings; reverse requires
    braking first. Horn remains independent. Camera/free-look settings and actual
    device prompts are in pause/help. Selected weather persists across individual
    eliminations. Rematch restores all trucks, debris, signals and countdown.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
