  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Two asymmetric teams, default four trucks each. One side has visible ice
    cannons; the other runs and rescues. ACTION sprays a bounded physical sphere-cast
    ice burst straight along the cannon: aim by steering. Solid cover blocks it.
    Three full hits build100%ice; no shots through walls and no friendly freezing.
    Fully frozen trucks remain physically present inside visible ice shells and CANNOT
    drive. There is NO automatic thawing. An unfrozen teammate must hit the ice with
    a meaningful impact to shatter it and restore driving; resting overlap and enemies
    cannot rescue. Rescued trucks receive two seconds of protection. Freeze every
    runner before time expires to win the round; any surviving runner at time-up
    wins for the runners. Roles switch EVERY round. Choose2/4/6rounds; each side
    gets equal turns in each role. Most round wins takes the match, equal wins share
    first place. AI uses the same line-of-sight spray and real driving/contact rescue
    rules. Selected weather stays for the whole match. Full cab/chase/shared, independent
    input, horn, Your Crew, optional AI views, recorded highlights and rematches
    use collection controls.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
