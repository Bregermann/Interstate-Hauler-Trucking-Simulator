  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ram the giant hanging paper pi\xF1ata with your real truck. A solid impact
    above 2.5 m/s swings it and breaks its CoreCollapse shell; rubbing or parking
    against it earns nothing. Damage earns small points; released candy earns the
    big rewards. Wrapped sweets are 10 points, golden stars 50, and black fused sweets
    explode on collection: lose up to 15 points and receive a physical shove. Drive
    into each physical sweet to claim it once. AI drives the same trucks, strikes
    the same shell, chases the same sweets and avoids explosives. Each pi\xF1ata
    allows 55 seconds to break it and 24 seconds to collect; a timed-out intact shell
    earns no candy. Three, five or seven pi\xF1atas form a match. Ties share first
    place. ACTION is a cooldown-limited in-place hop/upright recovery, never a teleport.
    Collection drive, horn, shared/chase/cab, free-look, pause and crew controls
    are retained. Profiles, names and colors use the shared setup. Rematch resets
    health, candies, scores and trucks."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
