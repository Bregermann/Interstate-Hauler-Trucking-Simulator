  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PRECIOUS CARGO\nFour pairs race three obstacle courses. The large truck
    carries a smaller partner on a visible roof cradle. Each driver and passenger
    has an independent name, source and AI difficulty; edit pair names through TEAM
    NAMES. Up to four humans can share pairs or join different pairs.\n\nDRIVER:
    movement accelerates, steers and brakes before reversing. Slow for banks, slalom,
    ramps and mud. PASSENGER: movement leans fore/aft and sideways; HOLD ACTION to
    brace. Lean changes the constrained physical load and transfers an equal opposite
    reaction to the driver. There is no extra propulsion. Excessive tilt or a violent
    impact can drop your partner.\n\nDROPPED PARTNER: stop within4.8m and under1.6m/s
    to pick up. The visible lift takes1.2s, then a fixed FIVE-SECOND stationary penalty.
    Other pairs keep racing. You cannot advance during pickup, skip gates or retrieve
    a partner from far away. Both trucks must cross carried. Ordered flags prevent
    bypass wins. A genuinely stranded pair or180s timeout is DNF, never an invented
    finish.\n\nValid finishers earn4/3/2/1 points; DNF zero. Three races, highest
    total; tied leaders race again. Between races choose SWAP ROLES, or select automatic
    swapping in setup. Role swaps retain each person\u2019s name, device and pair
    score. Shared partners retain one view. Offline only; pause/disconnect preserves
    physics and scores."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
