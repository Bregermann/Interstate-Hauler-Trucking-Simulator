  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Eight trucks scramble across a finite network of platforms above molten
    lava. Touching a platform starts its warning: orange becomes red, cracks appear,
    then the whole platform physically falls. Escape before it drops. Use JUMP to
    clear gaps; it only works from a supported upright truck and needs a short recharge.
    Narrow, moving, tilting, short-warning and temporary-safe platforms offer different
    risks. Ramming is allowed. Survival decides placement; +1 per 15 seconds, +1
    for a recent credited knockoff and +5 for the last survivor are bonus statistics.
    Simultaneous final lava impacts share placing. Solo continues until your actual
    lava impact. Choose longer, standard or fast warnings. Shared/chase/full cab,
    camera switch, free look, horn, Your Crew, selected weather and optional AI views
    use the collection controls. Rematch restores the entire arena. Watch the final
    escape sequence again from Results.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
