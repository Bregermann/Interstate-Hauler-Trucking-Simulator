.factory-body { flex-direction: row; flex-grow: 1; min-height: 200px; }
.passenger-list { width: 230px; border-right-width: 1px; border-right-color: #505050; margin-right: 8px; }
.grow { flex-grow: 1; }
.section-title { font-size: 18px; margin-bottom: 8px; }
.actions { flex-direction: row; flex-wrap: wrap; padding-top: 4px; padding-bottom: 4px; }
.actions Button { min-height: 25px; margin-right: 4px; }
.logs { height: 120px; margin-top: 4px; white-space: normal; }
