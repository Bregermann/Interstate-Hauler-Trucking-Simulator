  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Bake a real cake in your own NWH truck using a physical articulated ingredient
    scoop/cradle, whisk, tray and decorating nozzle. Original drive/steer, profiles,
    shared/chase/cab, pause, input recovery and rematch remain. ACTION grabs a vessel
    actually touching the wrist sensor; a fresh press drops it. Hold ACTION with
    drive/steer to adjust arm height/yaw while NWH handbrake holds. TOOL: keyboard
    Q/PageUp/Y/O, whole RB, own half shoulder. It tilts a held ingredient/batter
    container; with an empty hand at the mixing bowl it spins the actual whisk; after
    cooking it opens the gimballed cream nozzle. OVEN DOOR: keyboard E/PageDown/B/P,
    whole West, own half stick-click; actual presence at your oven controls is required.
    Recipe: flour0.8, milk0.5, sugar0.3, one egg. Pour measured contents into the
    actual bowl opening. Drop the physical egg into the bowl so native contact cracks
    it; a hard miss can break it on the floor. Fragile supplies are finite with one
    spare egg. Mix using the rotating whisk physically inside the bowl for8seconds.
    The stand then releases the real bowl. Pour at least2.1 batter into your physical
    cake pan. Carry/release the pan onto the actual oven shelf, close the moving
    door and heat around200degrees until cooked. Open/remove it; excessive heating
    reduces quality. Set it on the decorating counter and direct the real cream stream
    across all four cake quadrants. At least0.04 cream per quadrant forms a rosette.
    Finally place an intact decorated cake on your own judging table, upright and
    still for0.7seconds. Only this actual presentation scores recipe precision, cooking
    timing, retained cake and decoration once. No pickup/mixing/heat timer grants
    fake points. AI physically performs the same tasks and contact gates. A broken
    mixing bowl or cake pan fails that batch; setup/rematch resets the full recipe.
    General instructions remain here, not across the play view.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
  m_sharedMaterial: {fileID: -7304394381272760782, guid: 8e8f97682e668e94cb30d2e6b8e13d84,
