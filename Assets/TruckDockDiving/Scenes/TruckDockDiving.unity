  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "DOCK DIVING \xB7 THE TRUCK IS THE DIVER\nOne to eight competitors rotate
    through three attempts. Longest valid jump wins; solo is a personal-best challenge.
    Tied leaders take extra jumps against each other; each extra-round distance breaks
    that tie.\n\nDRIVE using your assigned cluster or stick. Opposite throttle brakes
    before reversing. ACTION jumps: keyboard key shown in setup; whole pad South;
    shared left LT / shared right RT. Press close to the dock edge for PERFECT timing.
    Early/late input is weaker; missing input gives a weak automatic jump. Speed
    and timing determine most of the distance.\n\nIn flight, left/right nudges trajectory.
    Release forward/back before range correction; total aftertouch is limited. No
    hovering or repeat jumps. The cab separates visually from the lower chassis over
    the same physical body.\n\nDistance is forward from the dock edge to the Rigidbody
    center at FIRST water-volume contact, rounded once to a whole inch. This same
    integer governs display, records and ties. Sideways distance adds nothing. Outside-pool
    center or a solid landing is a zero-distance foul. Failed approaches resolve
    after 30 seconds.\n\nEvery attempt has a recorded, nonphysical replay. Choose
    camera / speed / rewind, or skip after one second. Replay never reruns scores
    or forces. AI auto-advances. Pause/disconnect preserves the exact attempt; release
    inputs and confirm freshly to resume. Configuration survives rematch."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
