  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Inside a giant cartoon mouth, use your original NWH truck and physical
    articulated arm to treat three marked teeth and protect the healthy one. Original
    profiles, drive, pause, shared/chase/cab, free look and rematch remain. Hold
    ACTION plus drive/steer to adjust wrist height/yaw while the original NWH handbrake
    holds. TOOL: Q/PageUp/Y/O, whole RB, own half shoulder. NEXT TOOL: E/PageDown/B/P,
    whole West, own half stick-click; cycles toothbrush, drill, extraction forceps,
    air, water and cleaner/filling polisher. A fresh ACTION also releases an extracted
    clamped tooth. Every procedure requires actual selected tool contact with the
    correct tooth; position, real tip movement and native force matter. Dirty tooth:
    WATER, BRUSH, CLEANER, AIR. Cavity: WATER, DRILL, WATER, CLEANER to fill, AIR
    to dry. Loose marked tooth: WATER then clamp with EXTRACTION held, lift the arm
    and pull until the actual socket joint releases. No automatic extraction by a
    timer. Keep other tools away from healthy teeth. Rushing above2.8m/s or excessive
    native force loses points and can break a tooth; dangerous wrong tools lose points.
    Rinsing and drying are harmless on healthy teeth. Correct treatment stages score
    once; actual correct extraction scores90. Each checkup allows180seconds; three/five/seven
    form the match. AI selects and physically applies the same tools/arm/contacts.
    Patient reactions are playful and non-graphic; no blood. Rematch restores the
    original finite tooth/socket state and scores.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be1034cebd9fa3643a48d11ef76e4708, type: 2}
