# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/[Aa]ssets/[Ss]ceneDependencyCache*

# Private development telemetry endpoint configuration (never ship or commit).
analytics.local.json
analytics.local.json.meta

# Local terrain-authoring backups and Unity recovery/capture artifacts.
# Keep these on disk; authored roads, scenes and validation evidence stay tracked.
/EasyRoads3Dv3/
/Assets/Temp/
/Assets/Temp.meta
/Assets/_Recovery/
/Assets/_Recovery.meta
/Assets/EasyRoads3D/Resources/ERSideObjectsLog.prefab
/Assets/EasyRoads3D/Resources/ERSideObjectsLog.prefab.meta

# Isolated public-source Sports validation, kept inside this project.
/.sports-validation/

# Owned commercial animation source is imported locally by the Sports intake
# tool and bundled in the playable build; never publish the raw vendor files.
/Assets/TruckCheeseRolling/PrivateLicensedAnimations/
/Assets/TruckDragonKingdom/PrivateLicensedDragons/
/Assets/TruckDragonKingdom/PrivateLicensedDragons.meta
/Assets/TruckDragonKingdom/PrivateLicensedAnimalController/
/Assets/TruckDragonKingdom/PrivateLicensedAnimalController.meta
/Assets/TruckDragonKingdom/PrivateLicensedEnvironment/
/Assets/TruckDragonKingdom/PrivateLicensedEnvironment.meta
/Assets/TruckDragonKingdom/PrivateLicensedAudioVfx/
/Assets/TruckDragonKingdom/PrivateLicensedAudioVfx.meta
# Generated overlay clips retain licensed source motion curves. Keep the
# reproducible LWS authoring code public, the derived motion data local.
/Assets/TruckDragonKingdom/Animations/Authored/
/Assets/TruckDragonKingdom/Animations/Authored.meta
# Riders hover derivatives retain licensed source animation curves. Generate
# locally through owned authoring; never include them in the public payload.
/Assets/TruckDragonRiders/Animations/dragon-fire/
/Assets/TruckDragonRiders/Animations/dragon-fire.meta
/Assets/TruckDragonRiders/Animations/dragon-inferno/
/Assets/TruckDragonRiders/Animations/dragon-inferno.meta
# Saved castle-launch clips retain licensed source motion curves. Keep the
# generated authored folder local; publish its LWS recipe, never the payload.
/Assets/TruckDragonRiders/Animations/Authored/
/Assets/TruckDragonRiders/Animations/Authored.meta
/Assets/TruckHoardHeist/PrivateLicensedPotteryFragments/
/Assets/TruckHoardHeist/PrivateLicensedPotteryFragments.meta
/Assets/TruckDragonEscape/PrivateLicensedFragments/
/Assets/TruckDragonEscape/PrivateLicensedFragments.meta
/Assets/TruckCheeseRolling/PrivateLicensedAnimations.meta
/Assets/TruckCheeseRolling/PrivateLicensedVfx/
/Assets/TruckCheeseRolling/PrivateLicensedVfx.meta
/Assets/TruckDockDiving/PrivateLicensedProps/
/Assets/TruckDockDiving/PrivateLicensedProps.meta
/Assets/TruckDockDiving/PrivateLicensedVfx/
/Assets/TruckDockDiving/PrivateLicensedVfx.meta
/Assets/TruckFishing/PrivateLicensedWildlife/
/Assets/TruckFishing/PrivateLicensedWildlife.meta

/Assets/TruckSports/Customization/PrivateLicensedFragments/
/Assets/TruckSports/Customization/PrivateLicensedFragments.meta

/Assets/TruckBeerPong/Carnival/*.anim*
/Assets/TruckBeerPong/Carnival/Tailgate humanoid throw.FBX*

/Assets/TruckCornhole/Carnival/Yard *.anim*

/Assets/TruckSports/Customization/Meshes/truck.fire owned participant livery.asset*

/Assets/TruckSports/Customization/Meshes/novelty.icecream owned participant livery.asset*

# Dock-specific cuts embed owned commercial mesh geometry; keep source recipes local.
/Assets/TruckDockDiving/Customization/PrivateLicensedSplitBodies/
/Assets/TruckDockDiving/Customization/PrivateLicensedSplitBodies.meta

# Owned Digger PRO package is installed from the local licensed intake.
# Publish LWS adapters and configuration recipes, never raw commercial source.
/Assets/Digger/
/Assets/Digger.meta

# Exact owned SICS campsite sources are imported privately from the local cache.
# Publish the LWS dressing recipe, never the original purchased pack files.
/Assets/Toon Suburban Pack/
/Assets/Toon Suburban Pack.meta

# Exact Sports Digger authoring/streaming payloads are preserved locally.
# Public sources retain the licensed author/build recipe, not generated caches.
/Assets/DiggerData/Scenes/TruckArchaeology/
/Assets/DiggerData/Scenes/TruckArchaeology.meta
# Native Dragon Kingdom review voxel/mesh output is retained locally with
# receipt hashes; licensed/generated dependencies stay outside public source.
/Assets/DiggerData/Scenes/DK-RoundedIntegrated*/
/Assets/DiggerData/Scenes/DK-RoundedIntegrated*.meta
/Assets/StreamingAssets/DiggerData/archaeology-desert-07-01/
/Assets/StreamingAssets/DiggerData/archaeology-desert-07-01.meta
/Assets/TruckDragonKingdom/Ambience/PrivateLicensedAudio/
/Assets/TruckDragonKingdom/Ambience/PrivateLicensedAudio.meta
/Tools/TruckSports/Tests/__pycache__/

# Local Python caches and raw automated probe output stay on disk, outside Git.
__pycache__/
*.py[cod]
/Assets/Truck*/Native-*.json
/Assets/Truck*/Native-*.json.meta
/Assets/Truck*/*-SOURCE-*.json
/Assets/Truck*/*-SOURCE-*.json.meta
/Assets/Truck*/Source-Handoff.json
/Assets/Truck*/Source-Handoff.json.meta
/Documentation/TruckSports/Evidence/**/native-original-logs.zip
/Tools/TruckSports/ArtworkSources/Drafts/
# Superseded multi-gigabyte authoring experiments remain local; canonical
# kingdom assets and their reproducible authoring scripts remain publishable.
/Assets/TruckDragonKingdom/VisualCandidates/
/Assets/TruckDragonKingdom/VisualCandidates.meta
/Assets/TruckDragonKingdom/ReviewCandidates/
/Assets/TruckDragonKingdom/ReviewCandidates.meta
